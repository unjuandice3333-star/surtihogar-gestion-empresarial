TELEGRAM_ADMIN_CHAT_ID=-1001234567890
TELEGRAM_WEBHOOK_SECRET=tu_secreto_aleatorio_para_webhook_seguro

# Google Gemini AI (Opcional - Asistente de inventario y análisis contable)
