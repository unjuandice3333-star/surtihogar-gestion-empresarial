# ==============================================================================
# SurtiHogar / J&M — Plantilla de Variables de Entorno (.env.example)
# Copia este archivo como .env en tu entorno local.
# NUNCA subas tu archivo .env con valores reales a GitHub ni a repositorios públicos.
# ==============================================================================

# ==============================================================================
# 🌐 VARIABLES DEL CLIENTE (PÚBLICAS — Empaquetadas por Vite en el navegador)
# ==============================================================================
# URL del proyecto Supabase
VITE_SUPABASE_URL=https://REEMPLAZAR_CON_TU_ID_PROYECTO.supabase.co

# Clave pública 'anon' de Supabase (Diseñada para clientes; protegida mediante RLS).
# ⚠️ IMPORTANTE: NUNCA coloques aquí la clave 'service_role' privada de Supabase.
VITE_SUPABASE_ANON_KEY=REEMPLAZAR_CON_TU_CLAVE_PUBLICA_ANON_DE_SUPABASE

# URL base del backend para microservicios y proxy de IA (Opcional, por defecto http://localhost:3000)
VITE_API_URL=http://localhost:3000

# ==============================================================================
# 🔒 VARIABLES DEL SERVIDOR (PRIVADAS — Exclusivas de Node.js / Express / Bot)
# Estas variables residen ÚNICAMENTE en el servidor y nunca se envían al cliente.
# ==============================================================================
# Clave privada de Google Gemini AI (Mantenida 100% en el servidor para evitar fuga al navegador)
GEMINI_API_KEY=REEMPLAZAR_CON_TU_CLAVE_PRIVADA_DE_GOOGLE_GEMINI

# Token de bot de Telegram para alertas operacionales y reportes PDF
TELEGRAM_BOT_TOKEN=REEMPLAZAR_CON_TU_TOKEN_DE_TELEGRAM

# Chat ID o ID de canal/supergrupo de Telegram donde se envían los reportes
TELEGRAM_ADMIN_CHAT_ID=REEMPLAZAR_CON_TU_CHAT_ID_DE_TELEGRAM

# Token secreto aleatorio para validar la cabecera X-Telegram-Bot-Api-Secret-Token en el webhook
TELEGRAM_WEBHOOK_SECRET=REEMPLAZAR_CON_UN_SECRETO_ALEATORIO_PARA_WEBHOOK

# Puerto del servidor backend Express (Opcional, por defecto 3000)
PORT=3000

# URL pública del servidor en Render (Opcional, solo si se despliega en producción)
RENDER_EXTERNAL_URL=https://REEMPLAZAR_CON_TU_SERVICIO.onrender.com
